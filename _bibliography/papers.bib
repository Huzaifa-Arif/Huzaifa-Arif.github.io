  note={arXiv preprint},
  selected={true},
  bibtex_show={true},
  preview={PatchLLM.gif},
  html={https://arxiv.org/pdf/2511.08484},
  abstract={We propose patching for large language models (LLMs) like software versions, a lightweight and modular approach for addressing safety vulnerabilities. This "patch" introduces only 0.003% additional parameters, yet reliably steers model behavior toward that of a safer reference model across toxicity mitigation, bias reduction, and harmfulness refusal.}
}

