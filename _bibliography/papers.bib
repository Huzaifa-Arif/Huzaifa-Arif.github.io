@misc{arif2025dsfedproxgrad,
  title={DS FedProxGrad: Asymptotic Stationarity Without Noise Floor in Fair Federated Learning},
  author={Arif, Huzaifa},
  year={2025},
  month={December},
  note={arXiv preprint},
  selected={true},
  bibtex_show={true},
  html={https://arxiv.org/abs/2512.08671},
  abstract={In federated learning (FL), the FedProxGrad algorithm addresses the challenge of learning across heterogeneous datasets while emphasizing fairness through group-level disparity minimization. However, prior convergence analyses of FedProxGrad suffered from a significant limitation: the convergence rate depended on a noise floor term that could not be reduced to zero, preventing the algorithm from achieving exact stationarity. This paper presents a refined analysis that eliminates this noise floor dependence, establishing that DS FedProxGrad achieves asymptotic stationarity with an improved convergence rate. The new analysis provides stronger theoretical guarantees for fair federated learning scenarios.}
}

